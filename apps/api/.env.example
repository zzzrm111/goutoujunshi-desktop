# ===== 数据库 =====
DATABASE_URL=sqlite:///./data/assistant.db
API_HOST=127.0.0.1
API_PORT=8001

# ===== 对话模型（必填，公开版不内置任何供应商和密钥）=====
# MODEL_BASE_URL 填 [OI] 兼容接口的基础路径，服务会请求 {BASE_URL}/chat/completions
# 例：https://your-provider.example/v1
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 可选：实时语音单独走低延迟型号，留空则复用 MODEL_NAME
MODEL_REALTIME_NAME=
MODEL_REALTIME_MAX_TOKENS=80
MODEL_REALTIME_HISTORY_MESSAGES=6
MODEL_REALTIME_PROMPT_MODE=compact
MODEL_REALTIME_FIRST_SEGMENT_CHARS=8

# ===== 语音识别 ASR =====
# mock：不调用外部服务；cloud：[OI] 兼容 /audio/transcriptions；voicestudio：本地 VoiceStudio
ASR_PROVIDER=mock
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_REALTIME_MODEL=

# ===== 语音合成 TTS =====
# mock：返回测试音频；cloud：[OI] 兼容 /audio/speech；voicestudio：本地 VoiceStudio
TTS_PROVIDER=mock
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# 留空 = 使用服务端默认音色。填入你自己的 voice_id 即可指定音色。
TTS_VOICE=
# 迭代步数：越低越快、细节略减
TTS_REALTIME_NUM_STEP=8
TTS_CHAT_NUM_STEP=8
TTS_MANUAL_NUM_STEP=12

# ===== 视觉理解 =====
VISION_PROVIDER=mock
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ===== 跨域 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

# ===== 本地 VoiceStudio 示例（按需取消注释）=====
# ASR_PROVIDER=voicestudio
# ASR_BASE_URL=http://127.0.0.1:3900
# ASR_MODEL=Systran/faster-whisper-base
# ASR_REALTIME_MODEL=sherpa-zipformer-bilingual-zh-en
# TTS_PROVIDER=voicestudio
# TTS_BASE_URL=http://127.0.0.1:3900
# TTS_MODEL=omnivoice
# TTS_VOICE=